# Rafeeq demo settings. Copy to .env only if you want to change something.
# Default needs NOTHING here: it uses a free local model through Ollama.

PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
# OLLAMA_URL=http://localhost:11434
PORT=3000

# Optional, costs money: use Claude instead of the free local model
# PROVIDER=claude
# ANTHROPIC_API_KEY=your-key-here
# CLAUDE_MODEL=claude-opus-5-5
